# Copy this file to .env and fill in what you have. Every line is optional.
# With no model key at all, the app runs in mock mode: the whole interface and
# the execution engine work, tools really run, but replies are scripted.
# Never commit .env. Never paste keys into chat.

# ── Models: any ONE of these is enough. Two gives you automatic fallback. ──
# Free: https://console.groq.com/keys
GROQ_API_KEY=
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free models available: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Paid (the original app's provider): https://tokenfactory.nebius.com
NEBIUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local models: install Ollama, then set its address (usually http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
# Optional: force the default model, e.g. groq/openai/gpt-oss-120b
# OPENCREWBOT_DEFAULT_MODEL=

# ── Integrations (can also be saved in the app: Integrations page) ──
# GitHub: reading public repositories needs nothing. A token is needed to open issues.
GITHUB_TOKEN=
# Gmail: your address and a 16-character app password (myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Slack: an incoming webhook URL
SLACK_WEBHOOK_URL=
# Notion: an integration token and the page new pages go under
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# ── Optional extras from the original app ──
# Richer web search and crawling (search works without it, through DuckDuckGo)
TAVILY_API_KEY=
# Cloud browser for agents with the Browser tool
BROWSERBASE_API_KEY=
# 1,000+ apps through Composio
COMPOSIO_API_KEY=
# Jev routing for Auto rooms
TYPESAFE_API_KEY=

# ── Behaviour ──
# Where agents, chats, memory files, reports and the outbox live (default ./data)
# OPENCREWBOT_DATA_DIR=./data
# Force mock mode even when keys are set
# OPENCREWBOT_MOCK=1
# Tasks running at once (default 3) and the per-task time limit in ms (default 240000)
# OPENCREWBOT_MAX_PARALLEL=3
# OPENCREWBOT_TASK_TIMEOUT_MS=240000
# Continue interrupted plans automatically after a restart (default: you press Resume)
# OPENCREWBOT_AUTO_RESUME=1
# Key used to encrypt credentials saved in the app (default: generated in the data folder)
# OPENCREWBOT_SECRET_KEY=
